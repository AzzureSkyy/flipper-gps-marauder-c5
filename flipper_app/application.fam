App(
    appid="gps_nmea_marauder",
    name="[NMEA] GPS Marauder",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="gps_app",
    requires=["gui"],
    stack_size=1 * 1024,
    fap_icon="gps_10px.png",
    fap_category="GPIO",
    fap_private_libs=[
        Lib(
            name="minmea",
            sources=["minmea.c"],
            cdefines=["timegm=mktime"],
        ),
    ],
    fap_author="@ezod & @xMasterX",
    fap_version="1.6",
    fap_description="GPS via ESP32 Marauder board (ESP32-C5) using the 'nmea' CLI stream.",
)
